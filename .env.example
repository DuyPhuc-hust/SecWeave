# Copy file này thành .env (đã bị .gitignore chặn, không bao giờ commit được)
# rồi điền giá trị thật. Dùng cho `secweave hypothesize`/`secweave plan` (--llm-mode api, mặc định).
#
# Provider nào cũng được, miễn có endpoint tương thích chuẩn OpenAI Chat Completions —
# ví dụ Groq (https://api.groq.com/openai/v1), Google Gemini
# (https://generativelanguage.googleapis.com/v1beta/openai/), OpenAI, DeepSeek, OpenRouter...
# Xem SECWEAVE_SPEC.md §10.1 hoặc hỏi lại nếu cần so sánh giữa các provider.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
