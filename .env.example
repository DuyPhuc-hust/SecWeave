# Copy file này thành .env (đã bị .gitignore chặn, không bao giờ commit được)
# rồi điền giá trị thật. Dùng cho `secweave hypothesize` (--llm-mode api, mặc định).
#
# Ví dụ dưới đây dùng Google Gemini (miễn phí, lấy key tại aistudio.google.com).
# Đổi provider khác (Groq, OpenAI, DeepSeek, OpenRouter...) chỉ cần đổi 3 dòng
# này — xem SECWEAVE_SPEC.md hoặc hỏi lại nếu cần danh sách provider khác.

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
